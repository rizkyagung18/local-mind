{
  "name": "localmind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "dev": "pnpm --filter @localmind/contracts build && concurrently --kill-others --names contracts,server,web \"pnpm --filter @localmind/contracts dev\" \"pnpm --filter @localmind/server dev\" \"pnpm --filter @localmind/web dev\"",
    "build": "pnpm -r --sort build",
    "start": "pnpm --filter @localmind/server start",
    "typecheck": "pnpm --filter @localmind/contracts build && pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --filter @localmind/contracts build && vitest run --project unit",
    "test:integration": "pnpm --filter @localmind/contracts build && vitest run --project integration",
    "test:e2e": "pnpm build && playwright test",
    "doctor": "pnpm --filter @localmind/server run doctor",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
